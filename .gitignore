local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")

local Player = Players.LocalPlayer
local PlayerGui = Player:WaitForChild("PlayerGui")

local DISCORD = "https://discord.gg/Z3sWfTxUE"

local Old = PlayerGui:FindFirstChild("CustomKeySystem")
if Old then
    Old:Destroy()
end

local Gui = Instance.new("ScreenGui")
Gui.Name = "CustomKeySystem"
Gui.ResetOnSpawn = false
Gui.IgnoreGuiInset = true
Gui.Parent = PlayerGui

local function Font(obj, bold)
    obj.FontFace = Font.new(
        "rbxasset://fonts/families/Arimo.json",
        bold and Enum.FontWeight.Bold or Enum.FontWeight.Regular,
        Enum.FontStyle.Normal
    )
end

local function Corner(obj, radius)
    local c = Instance.new("UICorner")
    c.CornerRadius = UDim.new(0, radius)
    c.Parent = obj
end

local function Stroke(obj, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color
    s.Thickness = thickness
    s.Transparency = 0.12
    s.Parent = obj
end

local function Tween(obj, time, props)
    return TweenService:Create(
        obj,
        TweenInfo.new(time, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
        props
    )
end

