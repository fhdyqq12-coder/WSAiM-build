local Percent = Instance.new("TextLabel")
Percent.Size = UDim2.new(1,0,0,25)
Percent.Position = UDim2.new(0,0,0.56,0)
Percent.BackgroundTransparency = 1
Percent.Text = "0%"
Percent.TextColor3 = Color3.fromRGB(150,155,170)
Percent.TextSize = 13
Percent.ZIndex = 101
Percent.Parent = Loading
Font(Percent, false)

task.spawn(function()
    for i = 0,100 do
        Bar.Size = UDim2.new(i/100,0,1,0)
        Percent.Text = i .. "%"

        if i < 35 then
            LoadingText.Text = "Preparing..."
        elseif i < 70 then
            LoadingText.Text = "Loading interface..."
        else
            LoadingText.Text = "Almost ready..."
        end

        task.wait(0.018)
    end
end)

